    {
      "folder": "Campaigns",
      "template": "Templates/Campaign Template.md"
    },
    {
      "folder": "Learning-Paths",
      "template": "Templates/Learning Path Template.md"
    },
    {
      "folder": "Achievements",
      "template": "Templates/Achievement Template.md"
    }
  ],
  "enable_file_templates": false,
  "file_templates": [
    {
      "regex": ".*",
      "template": ""
