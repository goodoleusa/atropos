# =============================================================================
# OSINT CrewAI — copy to .env and set values. Never commit .env (it is gitignored).
# =============================================================================

# ==================== API KEYS — LLM (required for crew) ====================
# Get key at https://openrouter.ai/keys . Fallback: OPENAI_API_KEY
OPENROUTER_API_KEY=

# ==================== API KEYS — Threat intel / OSINT (optional) ============
# Paste your tokens below; leave empty to skip that tool.

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/api (free: 1000 req/day)
ABUSEIPDB_API_KEY=

# Censys — https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# Greynoise — https://www.greynoise.io/v3/docs/authentication
GREYNOISE_API_KEY=

# Shodan — https://account.shodan.io (InternetDB works without key)
SHODAN_API_KEY=

# IPinfo — https://ipinfo.io/signup (free tier without key)
IPINFO_TOKEN=

# HackerTarget — https://hackertarget.com/dashboard/ (free 50 req/day without key)
HACKERTARGET_API_KEY=

# Hybrid Analysis — https://www.hybrid-analysis.com/my-account → API key tab
HYBRID_ANALYSIS_API_KEY=

# RIPEStat: no key required (free).

# ==================== Output path ====================
# Folder that directly contains investigation subfolders (e.g. .../10-Investigations).
# On Windows use forward slashes: C:/Users/.../Huntin/10-Investigations
# OBSIDIAN_INVESTIGATIONS_PATH=

# ==================== Logging / tracing (optional) ====================
# LITELLM_LOG=WARNING
# WEAVE_ENABLED=0
# WEAVE_DISABLED=1
