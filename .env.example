# Required for database
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Required for AI agent (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-from-openrouter-ai

# Optional
PORT=5000
NODE_ENV=development

# Optional: admin API protection
APP_ACCESS_TOKEN=your-secret-token

# Optional: Replit admin (comma-separated Replit user IDs)
ADMIN_USER_IDS=user-id-1,user-id-2

# Optional: skip Atropos scanner build (use if Rust build fails)
# SKIP_ATROPOS_BUILD=1
