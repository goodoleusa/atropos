# Atropos Edge Agent Configuration

# Client Configuration (REQUIRED)
CLIENT_ID=your_client_id_here
ATROPOS_CLOUD_API=https://atropos-platform.vercel.app

# Service Tier (affects agent configuration)
SERVICE_TIER=mid_market  # Options: small_business, mid_market, enterprise

# Scan Frequency (seconds)
SCAN_INTERVAL=3600  # Default: 1 hour

# AI Configuration
OLLAMA_HOST=http://localhost:11434
GROQ_API_KEY=  # Optional: For cloud-based heavy analysis (FREE tier available)

# Optional: External Tool APIs
SHODAN_API_KEY=  # Optional: For internet-facing asset discovery
VIRUSTOTAL_API_KEY=  # Optional: For malware analysis

# Monitoring
GRAFANA_PASSWORD=changeme123

# Alert Configuration (override defaults from cloud)
ALERT_EMAIL=  # Override client default alert emails
ALERT_SLACK_WEBHOOK=  # Override client default Slack webhook
